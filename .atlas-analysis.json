  "keyFeatures": [
    "Real-time TCP connection tracking with kprobes",
    "UDP traffic monitoring for IPv4 and IPv6",
    "Network metrics collection (bytes, packets, ports)",
    "Process attribution with PID, UID, and command names",
    "Netlink socket diagnostics integration",
    "High-performance perf buffer event streaming"
  ],
  "publicApiSurface": [
    "AddProbe() - Initialize TCP event tracer",
    "setupBPF() - Setup BPF program for TCP monitoring",
    "DequeuePerfEvent() - Retrieve TCP events from queue",
    "cleanup() - Cleanup and detach TCP probes",
    "getStatus() - Get TCP tracer status",
    "AddProbe() - Initialize UDP event tracer",
    "setupBPF() - Setup BPF program for UDP monitoring",
    "DequeuePerfEvent() - Retrieve UDP events from queue",
    "cleanup() - Cleanup and detach UDP probes",
    "getStatus() - Get UDP tracer status",
    "tcp_event_t - TCP event data structure",
    "udp_event_t - UDP event data structure"
